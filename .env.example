# Public site URL (used for canonical URLs, sitemap, schema, OG tags)
NEXT_PUBLIC_SITE_URL=https://www.icbeautyinyou.com

# Kie.ai — used only by scripts/generate-images.mjs (never shipped to the browser)
KIE_API_KEY=

# Owner dashboard (/admin)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Email from Iisha's Gmail (Google Account -> Security -> App passwords)
GMAIL_APP_PASSWORD=

# Square: one Production access token (Square Developer -> "Website" app -> Credentials -> Production)
# powers the customer sync AND the live hours / services / prices on the site.
SQUARE_ACCESS_TOKEN=
# Optional: instant refresh when she edits Square (Webhooks -> Subscriptions -> signature key)
SQUARE_WEBHOOK_SIGNATURE_KEY=
